{
  "name": "pokestride",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-tesseract.mjs && node scripts/fetch-core.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "fetch-core": "node scripts/fetch-core.mjs --force",
    "test": "vitest run",
    "make-test-rom": "esbuild tools/make-test-rom.ts --bundle --platform=node --format=esm --outfile=.tmp-make-rom.mjs --log-level=error && node .tmp-make-rom.mjs test-fixtures/emerald-synthetic.gba && rm .tmp-make-rom.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.453.0",
    "nostalgist": "0.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
